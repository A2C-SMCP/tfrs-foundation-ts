TFRS_AUTH_E2E=0
TFRS_AUTH_E2E_TOKEN_URL=http://localhost:8080/api/v1/oauth/token
TFRS_AUTH_E2E_JWKS_URL=http://localhost:8080/.well-known/jwks.json
TFRS_AUTH_E2E_ISSUER=http://localhost:8080

# client_credentials
TFRS_AUTH_E2E_CLIENT_ID=
TFRS_AUTH_E2E_CLIENT_SECRET=
TFRS_AUTH_E2E_AUDIENCE=
TFRS_AUTH_E2E_SCOPE=a2a:invoke

# PAT token exchange
TFRS_AUTH_E2E_PAT=
TFRS_AUTH_E2E_PAT_AUDIENCE=
TFRS_AUTH_E2E_PAT_SCOPE=config:read

# User JWT token exchange (the test logs in first)
TFRS_AUTH_E2E_LOGIN_PHONE=
TFRS_AUTH_E2E_LOGIN_PASSWORD=
TFRS_AUTH_E2E_USER_JWT_AUDIENCE=
TFRS_AUTH_E2E_USER_JWT_SCOPE=config:read
